[manager]
cwd = { fg = "#e7bdba", bold=true}

hovered         = { fg = "#ffdad7", bg = "#733331" }
preview_hovered = { underline = true, bold=true }


[status]
separator_open  = ""
separator_close = ""
separator_style = { fg = "#ffdad7", bg = "#733331" }

# Mode
mode_normal = { fg = "#571d1d",   bg = "#ffb3af", bold = true }
mode_select = { fg = "#442928", bg = "#e7bdba", bold = true }
mode_unset  = { fg = "#402d05",  bg = "#e2c28c", bold = true }

[which]
mask            = { bg = "#271d1d" }
cand            = { fg = "#ffb3af" }
desc            = { fg = "#e7bdba" }
separator       = "  "
separator_style = { fg = "#e2c28c" }

[filetype]
rules = [
	# Images
	{ mime = "image/*", fg = "#e7bdba" },

	# Videos
	{ mime = "video/*", fg = "#e2c28c" },
	{ mime = "audio/*", fg = "#e2c28c" },

	# Archives
	{ mime = "application/zip",             fg = "#ffb4ab" },
	{ mime = "application/gzip",            fg = "#ffb4ab" },
	{ mime = "application/x-tar",           fg = "#ffb4ab" },
	{ mime = "application/x-bzip",          fg = "#ffb4ab" },
	{ mime = "application/x-bzip2",         fg = "#ffb4ab" },
	{ mime = "application/x-7z-compressed", fg = "#ffb4ab" },
	{ mime = "application/x-rar",           fg = "#ffb4ab" },

	# Fallback
	{ name = "*", fg = "#ffb3af", bold=true },
	{ name = "*/", fg = "#e7bdba", bold=true }
]
