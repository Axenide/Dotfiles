[manager]
cwd = { fg = "#c4c6d0", bold=true}

hovered         = { fg = "#dee2f2", bg = "#424753" }
preview_hovered = { underline = true, bold=true }


[status]
separator_open  = ""
separator_close = ""
separator_style = { fg = "#dee2f2", bg = "#424753" }

# Mode
mode_normal = { fg = "#2b303c",   bg = "#c2c6d6", bold = true }
mode_select = { fg = "#2e3038", bg = "#c4c6d0", bold = true }
mode_unset  = { fg = "#293041",  bg = "#bfc6dc", bold = true }

[which]
mask            = { bg = "#1f1f21" }
cand            = { fg = "#c2c6d6" }
desc            = { fg = "#c4c6d0" }
separator       = "  "
separator_style = { fg = "#bfc6dc" }

[filetype]
rules = [
	# Images
	{ mime = "image/*", fg = "#c4c6d0" },

	# Videos
	{ mime = "video/*", fg = "#bfc6dc" },
	{ mime = "audio/*", fg = "#bfc6dc" },

	# Archives
	{ mime = "application/zip",             fg = "#ffb4ab" },
	{ mime = "application/gzip",            fg = "#ffb4ab" },
	{ mime = "application/x-tar",           fg = "#ffb4ab" },
	{ mime = "application/x-bzip",          fg = "#ffb4ab" },
	{ mime = "application/x-bzip2",         fg = "#ffb4ab" },
	{ mime = "application/x-7z-compressed", fg = "#ffb4ab" },
	{ mime = "application/x-rar",           fg = "#ffb4ab" },

	# Fallback
	{ name = "*", fg = "#c2c6d6", bold=true },
	{ name = "*/", fg = "#c4c6d0", bold=true }
]
