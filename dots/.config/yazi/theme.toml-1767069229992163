[manager]
cwd = { fg = "#c2caab", bold=true}

hovered         = { fg = "#d3ec9e", bg = "#3a4d11" }
preview_hovered = { underline = true, bold=true }


[status]
separator_open  = ""
separator_close = ""
separator_style = { fg = "#d3ec9e", bg = "#3a4d11" }

# Mode
mode_normal = { fg = "#253600",   bg = "#b7d085", bold = true }
mode_select = { fg = "#2c331d", bg = "#c2caab", bold = true }
mode_unset  = { fg = "#013732",  bg = "#a0d0c8", bold = true }

[which]
mask            = { bg = "#1e2019" }
cand            = { fg = "#b7d085" }
desc            = { fg = "#c2caab" }
separator       = "  "
separator_style = { fg = "#a0d0c8" }

[filetype]
rules = [
	# Images
	{ mime = "image/*", fg = "#c2caab" },

	# Videos
	{ mime = "video/*", fg = "#a0d0c8" },
	{ mime = "audio/*", fg = "#a0d0c8" },

	# Archives
	{ mime = "application/zip",             fg = "#ffb4ab" },
	{ mime = "application/gzip",            fg = "#ffb4ab" },
	{ mime = "application/x-tar",           fg = "#ffb4ab" },
	{ mime = "application/x-bzip",          fg = "#ffb4ab" },
	{ mime = "application/x-bzip2",         fg = "#ffb4ab" },
	{ mime = "application/x-7z-compressed", fg = "#ffb4ab" },
	{ mime = "application/x-rar",           fg = "#ffb4ab" },

	# Fallback
	{ name = "*", fg = "#b7d085", bold=true },
	{ name = "*/", fg = "#c2caab", bold=true }
]
